pkgname=version
pkgver=1.7.0
pkgdesc="The + / ++ / +++ release tool for multi-file projects"
pkgrel=1
arch=('any')
license=('GPL-3.0')
url='https://github.com/Salamek/version'
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools')
depends=(
    'python'
    'python-yaml'
    'python-docopt'
    'python-gitpython'
    'python-packaging'
)

prepare() {
  mkdir -p "${srcdir}/${pkgname}"
  cp -R "${srcdir}/../../version" "${srcdir}/${pkgname}"
  cp -R "${srcdir}/../../tests" "${srcdir}/${pkgname}"
  cp -R "${srcdir}/../../setup.py" "${srcdir}/${pkgname}"
  cp -R "${srcdir}/../../pyproject.toml" "${srcdir}/${pkgname}"
  cp -R "${srcdir}/../../README.md" "${srcdir}/${pkgname}"
}

build() {
  cd "${srcdir}/${pkgname}"
  python -m build --wheel --no-isolation
}

package() {
  cd "${srcdir}/${pkgname}"
  python -m installer --destdir="$pkgdir" dist/*.whl
}
